[
  {"expr": "${age} >= 18", "values": {"age": "20"}, "expect": true},
  {"expr": "${age} >= 18", "values": {"age": "17"}, "expect": false},
  {"expr": "${age} >= 18", "values": {"age": ""}, "expect": false},
  {"expr": "${age} >= 18", "values": {}, "expect": false},
  {"expr": "${age} != 18", "values": {"age": ""}, "expect": true},
  {"expr": "${product_missing} = 'yes'", "values": {"product_missing": "yes"}, "expect": true},
  {"expr": "${product_missing} = 'yes'", "values": {"product_missing": "no"}, "expect": false},
  {"expr": "${product_missing} = 'yes'", "values": {}, "expect": false},
  {"expr": "${a} != ''", "values": {"a": "x"}, "expect": true},
  {"expr": "${a} != ''", "values": {"a": ""}, "expect": false},
  {"expr": "selected(${services}, 'pharmacy')", "values": {"services": "lab pharmacy"}, "expect": true},
  {"expr": "selected(${services}, 'pharm')", "values": {"services": "lab pharmacy"}, "expect": false},
  {"expr": "count-selected(${services}) >= 2", "values": {"services": "lab pharmacy"}, "expect": true},
  {"expr": "count-selected(${services})", "values": {"services": ""}, "expect": 0},
  {"expr": ". >= 18 and . <= 120", "current": "35", "expect": true},
  {"expr": ". >= 18 and . <= 120", "current": "150", "expect": false},
  {"expr": "string-length(.) <= 5", "current": "Douala", "expect": false},
  {"expr": "string-length(.)", "current": "été", "expect": 3},
  {"expr": "not(${a} = 'x') or ${b} > 2", "values": {"a": "x", "b": "3"}, "expect": true},
  {"expr": "not(${a} = 'x') or ${b} > 2", "values": {"a": "x", "b": "1"}, "expect": false},
  {"expr": "(${a} + ${b}) * 2", "values": {"a": "1", "b": "2.5"}, "expect": 7},
  {"expr": "${a} div 4", "values": {"a": "10"}, "expect": 2.5},
  {"expr": "${a} mod 3", "values": {"a": "10"}, "expect": 1},
  {"expr": "-${a} + 1", "values": {"a": "3"}, "expect": -2},
  {"expr": "if(${age} >= 18, 'adult', 'minor')", "values": {"age": "12"}, "expect": "minor"},
  {"expr": "coalesce(${nick}, ${name})", "values": {"nick": "", "name": "Awa"}, "expect": "Awa"},
  {"expr": "concat(${a}, '-', ${b})", "values": {"a": "x", "b": "y"}, "expect": "x-y"},
