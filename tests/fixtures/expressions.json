  {"expr": "${score} = '5'", "values": {"score": "5"}, "expect": true},
  {"expr": "true() and not(false())", "expect": true},
  {"expr": "number(${x}) > 1.5", "values": {"x": "2"}, "expect": true},
  {"expr": "${x} > 10", "values": {"x": "abc"}, "expect": false},
  {"expr": "regex(., '^[0-9]+$')", "current": "12", "error": true},
  {"expr": "${a} = ", "values": {"a": "1"}, "error": true},
