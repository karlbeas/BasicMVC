# Auto detect text files and perform LF normalization
* text=auto eol=lf
*.png binary
*.jpg binary
*.zip binary

# Not shipped in release archives (git archive)
/tests export-ignore
/.github export-ignore
# docs/schema/ stays: FormValidator reads the JSON Schema at runtime.
/docs/adr export-ignore
/docs/deployment export-ignore
/docs/MANIFEST.md export-ignore
/CLAUDE.md export-ignore
/worker export-ignore
/.php-cs-fixer.dist.php export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
