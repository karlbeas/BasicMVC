{
    "name": "karlbeas/f2s-pro",
    "description": "F2S Pro — Field, Form & Survey Pro : plateforme d'enquêtes intelligentes pour l'Afrique francophone",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "chillerlan/php-qrcode": "^5.0",
        "opis/json-schema": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "lint": [
            "php-cs-fixer check --diff",
            "phpstan analyse --memory-limit=512M"
        ],
        "fix": "php-cs-fixer fix",
        "migrate": "php bin/migrate.php",
        "release": "bash bin/build-release.sh"
    }
}
