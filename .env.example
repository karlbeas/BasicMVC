# F2S Pro — copier en .env (ne jamais versionner .env). Hors de la racine web en production.

APP_ENV=production
APP_DEBUG=false
# URL publique complète, sans / final (vide = détection automatique)
APP_URL=https://f2s.example.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
# false uniquement en local sans HTTPS
SESSION_SECURE_COOKIE=true

# MySQL 8+ ou MariaDB 10.6+ (souvent "localhost" en mutualisé)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Chemin absolu recommandé en production, hors racine web : /home/USER/f2s/storage
STORAGE_PATH=
MAX_UPLOAD_MB=10

# File de tâches (ADR 0002)
JOBS_TIME_BUDGET=50
JOBS_STALE_AFTER=600
# Jeton du déclencheur HTTP /cron/{jeton} — vide = désactivé ; 32 caractères minimum
CRON_HTTP_TOKEN=

# IA — API Mammouth (compatible OpenAI), utilisée à partir de la phase 2
MAMMOUTH_BASE_URL=https://api.mammouth.ai/v1
MAMMOUTH_API_KEY=
AI_TIMEOUT_SECONDS=25
AI_MODEL_FORM=gpt-6-luna
AI_MODEL_FORM_FALLBACK=deepseek-v4.1-flash
AI_MODEL_ANALYSIS_PLAN=deepseek-v4.1-flash
AI_MODEL_REPORT=gpt-6-luna
AI_MODEL_REPORT_PREMIUM=claude-sonnet-5-5
AI_MODEL_EMBEDDINGS=text-embedding-3-small
AI_DAILY_BUDGET_USD_PER_ORG=0.50

# Paiement (agrégateur à choisir — voir MANIFEST §10)
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

MAIL_FROM=no-reply@example.com
