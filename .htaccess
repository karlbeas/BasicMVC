# F2S Pro — installation directly in public_html (or a sub-folder of it).
# Every request is routed into public/; app/, config/, storage/, vendor/, .env…
# are never served (each internal folder also carries its own "Require all denied").
Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(\.env.*|composer\.(json|lock)|VERSION|.*\.(md|sql|sh|neon|dist|key|log))$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
