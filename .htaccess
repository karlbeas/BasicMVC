# F2S Pro — LAST-RESORT layout only: the whole project was uploaded into the
# web root (public_html). Prefer pointing the domain's document root to public/
# (see docs/deployment/shared-hosting.md). This file routes every request into
# public/ and denies direct access to app/, config/, storage/, vendor/, .env…
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
